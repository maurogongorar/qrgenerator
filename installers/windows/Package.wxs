<?xml version="1.0" encoding="utf-8"?>
<!--
  qrgen MSI installer authoring (WiX Toolset v6).

  The package uses Scope="perUserOrMachine", so the wizard shows a page where
  the user chooses between installing "just for me" (no elevation, under
  LocalAppData) or "for all users" (elevates via UAC and installs under Program
  Files). The installation folder is added to the PATH of the matching scope.

  The license page text is generated from the repository LICENSE (GNU GPL v3)
  by New-LicenseRtf.ps1.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
	 xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="qrgen"
		   Manufacturer="$(var.Manufacturer)"
		   Version="$(var.ProductVersion)"
		   UpgradeCode="7C1F4B2E-3A8D-4C6B-9E50-2F0B9A4D51C7"
		   Scope="perUserOrMachine"
		   Compressed="true"
		   InstallerVersion="500">

	<SummaryInformation Description="Command line utility to generate QR codes" />

	<MajorUpgrade DowngradeErrorMessage="A newer version of qrgen is already installed." />

	<MediaTemplate EmbedCab="true" />

	<!-- The advanced wizard includes the install scope selection page. -->
	<Property Id="ApplicationFolderName" Value="qrgen" />
	<Property Id="WixAppFolder" Value="WixPerUserFolder" />
	<Property Id="ARPNOREPAIR" Value="1" />

	<ui:WixUI Id="WixUI_Advanced" />
	<WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

	<!--
	  Default folder proposed on the install location page for each scope.
	  WixUI_Advanced publishes APPLICATIONFOLDER = [WixPerMachineFolder] or
	  [WixPerUserFolder]. Its own per machine default uses ProgramFilesFolder,
	  which Windows Installer redirects to %LOCALAPPDATA%\Programs while the
	  package is still per user, so the environment variable is used instead to
	  always propose the real Program Files folder.
	-->
	<SetProperty Id="WixPerMachineFolder"
				 Action="SetQrgenPerMachineFolder"
				 Value="[%ProgramW6432]\[ApplicationFolderName]"
				 After="WixSetDefaultPerMachineFolder"
				 Sequence="both" />

	<SetProperty Id="WixPerUserFolder"
				 Action="SetQrgenPerUserFolder"
				 Value="[LocalAppDataFolder]Programs\[ApplicationFolderName]"
				 After="WixSetDefaultPerMachineFolder"
				 Sequence="both" />


	<Feature Id="Main" Title="qrgen" Level="1" AllowAbsent="false">
	  <ComponentGroupRef Id="ApplicationFiles" />
	  <ComponentGroupRef Id="PathEntries" />
	</Feature>

  </Package>

  <Fragment>
	<!-- APPLICATIONFOLDER is the property that WixUI_Advanced redirects based
		 on the chosen scope (ProgramFiles64Folder or LocalAppDataFolder). -->
	<StandardDirectory Id="ProgramFiles6432Folder">
	  <Directory Id="APPLICATIONFOLDER" Name="qrgen" />
	</StandardDirectory>

	<!-- Every published file is harvested automatically. -->
	<ComponentGroup Id="ApplicationFiles" Directory="APPLICATIONFOLDER">
	  <Files Include="$(var.PublishDir)\**" />
	</ComponentGroup>
  </Fragment>

  <Fragment>
	<ComponentGroup Id="PathEntries" Directory="APPLICATIONFOLDER">

	  <!-- All users installation: machine PATH. -->
	  <Component Id="PathMachine" Guid="9B3D6C41-5E27-4F8A-8D13-6C2A7E940B55" Bitness="always64" Condition="ALLUSERS = 1">
		<Environment Id="PathSystem"
					 Name="PATH"
					 Value="[APPLICATIONFOLDER]"
					 Permanent="false"
					 Part="last"
					 Action="set"
					 System="yes" />
		<RegistryValue Root="HKLM"
					   Key="Software\qrgen"
					   Name="InstallPath"
					   Type="string"
					   Value="[APPLICATIONFOLDER]"
					   KeyPath="yes" />
	  </Component>

	  <!-- Per user installation: current user PATH. -->
	  <Component Id="PathUser" Guid="4E8A1D97-72B6-4F03-A5C4-1D9F6B2E8A30" Bitness="always64" Condition="NOT ALLUSERS">
		<Environment Id="PathUser"
					 Name="PATH"
					 Value="[APPLICATIONFOLDER]"
					 Permanent="false"
					 Part="last"
					 Action="set"
					 System="no" />
		<RegistryValue Root="HKCU"
					   Key="Software\qrgen"
					   Name="InstallPath"
					   Type="string"
					   Value="[APPLICATIONFOLDER]"
					   KeyPath="yes" />
	  </Component>

	</ComponentGroup>
  </Fragment>

</Wix>
